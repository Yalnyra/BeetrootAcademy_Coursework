{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cppcheck: project",
      "type": "shell",
      "command": "C:\\Program Files\\Cppcheck\\cppcheck.exe",
      "args": [
        "--enable=warning,style,performance,portability",
        "--inline-suppr",
        "--suppress=missingIncludeSystem",
        "--std=c11",
        "--project=${workspaceFolder}/build/compile_commands.json",
        // "-I", "${workspaceFolder}/include",
        "--cppcheck-build-dir=${workspaceFolder}/.cppcheck",
        "--template={file}:{line}:{column}: {severity}: {message} [{id}]",
        "--quiet"
        // "${workspaceFolder}/main/miniproject_3/src"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "none",
      "presentation": { "reveal": "silent", "clear": true },
      "problemMatcher": {
        "owner": "cppcheck",
        "source": "cppcheck",
        "fileLocation": "absolute",
        "severity": "warning",
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+):\\s+(\\w+):\\s+(.*)$",
          "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
        }
      }
    },
    {
      "label": "cppcheck: current file",
      "type": "shell",
      "command": "C:\\Program Files\\Cppcheck\\cppcheck.exe",
      "args": [
        "--enable=warning,style,performance,portability",
        "--inline-suppr",
        "--suppress=missingIncludeSystem",
        "-I", "${workspaceFolder}/include",
        "--template={file}:{line}:{column}: {severity}: {message} [{id}]",
        "--quiet",
        "${file}"
      ],
      "presentation": { "reveal": "silent", "clear": true },
     "problemMatcher": {
        "owner": "cppcheck",
        "source": "cppcheck",
        "fileLocation": "absolute",
        "severity": "warning",
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+):\\s+(\\w+):\\s+(.*)$",
          "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
        }
    }
    }
  ]
}