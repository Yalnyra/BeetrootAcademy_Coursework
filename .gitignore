# ---------------------------------------------------------------------------
# Shared .gitignore for every project in this repository.
# Individual project folders should NOT carry their own .gitignore.
# ---------------------------------------------------------------------------

# PlatformIO -----------------------------------------------------------------
.pio/
.pioenvs/
.piolibdeps/
.clang_complete
.gcc-flags.json
compile_commands.json

# VS Code --------------------------------------------------------------------
# Keep the two files that describe the project; ignore machine-generated ones.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/

# Build artefacts ------------------------------------------------------------
*.o
*.obj
*.a
*.elf
*.su
*.map
*.lst
*.d

# Toolchain / debug ----------------------------------------------------------
.gdb_history
*.ioc.bak

# Python ---------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/

# OS -------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# Editors --------------------------------------------------------------------
*.swp
*.swo
*~

# NOTE: *.pdf is deliberately NOT ignored - homework handouts are tracked.
